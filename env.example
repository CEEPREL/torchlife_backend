# ---------------------------
# Server Configuration
# ---------------------------
NODE_ENV=development
PORT=3000
CORS_PROD=https://yourfrontenddomain.com

# ---------------------------
# Database (PostgreSQL)
# ---------------------------
# Backend app connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/torchlife

# Only needed when you run the local Docker Postgres service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=torchlife

# ---------------------------
# Redis (Cache / Queues)
# ---------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------
# Authentication
# ---------------------------
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---------------------------
# Email (SMTP or Mail Service)
# ---------------------------
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_SENDER=your_email@example.com
EMAIL_SECURE=false

# ---------------------------
# Cloudinary (Media Storage)
# ---------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------------------------
# Paystack (Payments)
# ---------------------------
PAYSTACK_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://your-frontend-domain.com/payments/callback
