generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  first_name                 String
  last_name                  String
  password                   String
  email                      String                      @unique
  activities                 USER_ACTIVITIES?
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @updatedAt
  deleted_at                 DateTime?
  phone_number               String?                     @unique
  isverified                 Boolean
  role                       USER_ROLES?                 @default(USER)
  refreshToken               String?
  marketing_metadata         Json?
  last_marketing_sync_at     DateTime?
  philanthropic_name         String                      @unique
  impact_score               Int                         @default(0)
  emergencies_supported      Int                         @default(0)
  campaigns                  Campaign[]                  @relation("campaign_owner")
  verified_campaigns         Campaign[]                  @relation("verified_campaigns")
  donations                  Donation[]
  document_requests          SupportingDocumentRequest[] @relation("document_request_user")
  reviewed_document_requests SupportingDocumentRequest[] @relation("document_request_admin")
  extension_audits           CampaignExtensionAudit[]    @relation("campaign_extension_audits_admin")
  fileUploads                FileUpload[]
  payment                    Payment[]
  ratings                    Rating[]
  wallet                     Wallet?

  @@map("users")
}

model OtpToken {
  pkId       Int      @default(autoincrement())
  token      String   @unique
  userId     String
  expiryDate DateTime
}

model FileUpload {
  id           String   @id @default(uuid()) @db.Uuid
  publicId     String   @unique
  url          String
  format       String
  resourceType String
  sizeInBytes  Int
  originalName String
  uploadedAt   DateTime @default(now())
  userId       String?  @db.Uuid
  campaignId   String   @db.Uuid
  mimeType     String?
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@map("file_uploads")
}

model Donation {
  id           String          @id @default(uuid()) @db.Uuid
  amount       Int
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  deleted_at   DateTime?
  user_id      String          @db.Uuid
  campaign_id  String          @db.Uuid
  status       DONATION_STATUS @default(PENDING)
  donor_email  String?
  is_anonymous Boolean         @default(false)
  campaign     Campaign        @relation(fields: [campaign_id], references: [id])
  user         User            @relation(fields: [user_id], references: [id])
  payment      Payment[]

  @@index([campaign_id, status])
  @@index([user_id, status])
  @@map("donations")
}

model Campaign {
  id                     String                      @id @default(uuid()) @db.Uuid
  public_id              String                      @unique @default(cuid())
  title                  String
  certified_pdf          String
  image_url              String
  status                 CAMPAIGN_STATUS             @default(PENDING)
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt
  deleted_at             DateTime?
  deleted_by_id          String?                     @db.Uuid
  is_deleted             Boolean                     @default(false)
  user_id                String                      @db.Uuid
  amount_raised          Int                         @default(0)
  deadline               DateTime
  story                  String?
  target_amount          Int
  proxyAddress           String?
  proxyEmail             String?
  proxyName              String?
  proxyNote              String?
  proxyPhone             String?
  type                   USER_ROLES                  @default(USER)
  batch                  Int                         @default(1)
  location               String?
  hospital_name          String?
  hospital_contact       String?
  hospital_contact_person_name String?
  priority               CAMPAIGN_PRIORITY           @default(LOW)
  records                String[]
  verified_by_id         String                      @db.Uuid
  currency               CURRENCY                    @default(NGN)
  approval_email_sent    Boolean                     @default(false)
  approved_by_id         String?                     @db.Uuid
  approved_at            DateTime?
  approval_notes         String?
  extension_status       CAMPAIGN_EXTENSION_STATUS   @default(NONE)
  requested_deadline     DateTime?
  extension_requested_at DateTime?
  extension_reviewed_at  DateTime?
  user                   User                        @relation("campaign_owner", fields: [user_id], references: [id])
  verified_by            User                        @relation("verified_campaigns", fields: [verified_by_id], references: [id])
  donations              Donation[]
  fileUploads            FileUpload[]
  document_requests      SupportingDocumentRequest[]
  extension_audits       CampaignExtensionAudit[]
  ratings                Rating[]
  wallet                 Wallet?

  @@map("campaigns")
}

model Payment {
  id                      String              @id @default(uuid()) @db.Uuid
  amount                  Int
  synced_at               DateTime?
  tx_ref                  String              @unique
  custom_tx_ref           String
  status                  PAYMENT_STATUS
  comment                 String?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  deleted_at              DateTime?
  donation_id             String?             @db.Uuid
  user_id                 String?             @db.Uuid
  currency                CURRENCY
  type                    PAYMENT_TYPE
  meta                    Json?
  wallet_id               String?             @db.Uuid
  provider                String?
  donor_email             String?
  payment_channel         String?
  paystack_transaction_id BigInt?
  verified_at             DateTime?
  walletTransactions      WalletTransaction[]
  withdrawalRequests      WithdrawalRequest[]
  donation                Donation?           @relation(fields: [donation_id], references: [id])
  user                    User?               @relation(fields: [user_id], references: [id])
  wallet                  Wallet?             @relation(fields: [wallet_id], references: [id])
  webhook                 Webhook?

  @@index([donation_id])
  @@index([user_id, status])
  @@index([provider, status])
  @@map("payments")
}

model Wallet {
  id                String              @id @default(uuid()) @db.Uuid
  balance           Int
  user_id           String?             @unique @db.Uuid
  currency          CURRENCY            @default(NGN)
  campaign_id       String?             @unique @db.Uuid
  account_status    ACCOUNT_STATUS      @default(ACTIVE)
  WalletTransaction WalletTransaction[]
  payments          Payment[]
  campaign          Campaign?           @relation(fields: [campaign_id], references: [id])
  user              User?               @relation(fields: [user_id], references: [id])

  @@map("wallets")
}

model WalletTransaction {
  id          String         @id @default(uuid()) @db.Uuid
  amount      Int
  type        PAYMENT_TYPE
  currency    CURRENCY
  status      PAYMENT_STATUS @default(PENDING)
  reference   String         @unique
  description String?
  meta        Json?
  wallet_id   String         @db.Uuid
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  payment_id  String?        @db.Uuid
  payment     Payment?       @relation(fields: [payment_id], references: [id])
  wallet      Wallet         @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id])
}

model WithdrawalRequest {
  id           String            @id @default(uuid()) @db.Uuid
  user_id      String            @db.Uuid
  wallet_id    String            @db.Uuid
  amount       Int
  status       WITHDRAWAL_STATUS
  reason       String?
  initiated_at DateTime          @default(now())
  processed_at DateTime?
  payment_id   String?           @db.Uuid
  payment      Payment?          @relation(fields: [payment_id], references: [id])
}

model Webhook {
  id                String    @id @default(uuid()) @db.Uuid
  event             Json
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?
  payment_id        String?   @unique @db.Uuid
  event_type        String?
  reference         String?
  paystack_event_id String?   @unique
  payment           Payment?  @relation(fields: [payment_id], references: [id])

  @@index([reference])
  @@map("webhooks")
}

model Rating {
  id          String    @id @default(uuid()) @db.Uuid
  score       Int
  comment     String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  user_id     String    @db.Uuid
  campaign_id String    @db.Uuid
  campaign    Campaign  @relation(fields: [campaign_id], references: [id])
  user        User      @relation(fields: [user_id], references: [id])

  @@map("ratings")
}

model SupportingDocumentRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  user_id        String                  @db.Uuid
  campaign_id    String                  @db.Uuid
  requested_at   DateTime                @default(now())
  reviewed_at    DateTime?
  reviewed_by_id String?                 @db.Uuid
  status         DOCUMENT_REQUEST_STATUS @default(PENDING)
  campaign       Campaign                @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  user           User                    @relation("document_request_user", fields: [user_id], references: [id], onDelete: Cascade)
  reviewed_by    User?                   @relation("document_request_admin", fields: [reviewed_by_id], references: [id])

  @@unique([user_id, campaign_id])
  @@index([campaign_id, status])
  @@map("supporting_document_requests")
}

model CampaignExtensionAudit {
  id           String   @id @default(uuid()) @db.Uuid
  campaign_id  String   @db.Uuid
  admin_id     String   @db.Uuid
  old_deadline DateTime
  new_deadline DateTime
  created_at   DateTime @default(now())
  campaign     Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  admin        User     @relation("campaign_extension_audits_admin", fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, created_at])
  @@map("campaign_extension_audits")
}

model Campaigns {
  id            String             @id @default(cuid())
  title         String
  category      CampaignCategory
  story         String
  amountNeeded  Float
  amountRaised  Float              @default(0)
  currency      String
  status        CampaignStatus
  verified      Boolean            @default(false)
  submitterType String
  beneficiaryId String
  submitterId   String?
  hospitalId    String
  consentId     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  documents     CampaignDocument[]
  updates       CampaignUpdate[]
  beneficiary   Beneficiary        @relation(fields: [beneficiaryId], references: [id])
  consent       Consent            @relation(fields: [consentId], references: [id])
  hospital      Hospital           @relation(fields: [hospitalId], references: [id])
  submitter     Submitter?         @relation(fields: [submitterId], references: [id])
}

model Submitter {
  id           String      @id @default(cuid())
  name         String
  relationship String?
  phone        String
  email        String
  campaigns    Campaigns[]
}

model Beneficiary {
  id                     String      @id @default(cuid())
  name                   String
  countryOfResidence     String
  expectedDateOfDelivery DateTime
  medicalConditions      String[]
  campaigns              Campaigns[]
}

model Hospital {
  id        String      @id @default(cuid())
  name      String
  phone     String
  address   String
  campaigns Campaigns[]
}

model Consent {
  id        String      @id @default(cuid())
  agreed    Boolean
  agreedAt  DateTime
  campaigns Campaigns[]
}

model CampaignUpdate {
  id         String    @id @default(cuid())
  campaignId String
  message    String
  visibility String
  createdBy  String
  status     String    @default("PUBLISHED")
  createdAt  DateTime  @default(now())
  campaign   Campaigns @relation(fields: [campaignId], references: [id])
}

model CampaignDocument {
  id         String    @id @default(cuid())
  campaignId String
  fileName   String
  fileUrl    String
  mimeType   String
  isHero     Boolean   @default(false)
  type       String
  visibility String
  campaign   Campaigns @relation(fields: [campaignId], references: [id])
}

enum USER_ACTIVITIES {
  DONOR
  RECEIVER
}

enum USER_ROLES {
  ADMIN
  USER
  SUPER_ADMIN
  PROXY
}

enum DONATION_STATUS {
  PENDING
  FAILED
  REJECTED
  SUCCESS
}

enum CAMPAIGN_STATUS {
  PENDING
  APPROVED
  REJECTED
}

enum CAMPAIGN_PRIORITY {
  LOW
  MEDIUM
  HIGH
}

enum CAMPAIGN_EXTENSION_STATUS {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum DOCUMENT_REQUEST_STATUS {
  PENDING
  APPROVED
  REJECTED
}

enum CURRENCY {
  NGN
  USD
  CRYPTO
}

enum PAYMENT_STATUS {
  PENDING
  FAILED
  REJECTED
  SUCCESS
}

enum PAYMENT_TYPE {
  DEPOSIT
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum ACCOUNT_STATUS {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WITHDRAWAL_STATUS {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum SubmitterType {
  SELF
  PROXY
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CampaignCategory {
  URGENT
  MILESTONE
  OFFSET
  FIRSTFUND
}
